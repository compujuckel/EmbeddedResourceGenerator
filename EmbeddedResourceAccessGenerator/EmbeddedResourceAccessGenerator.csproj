<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<TargetFramework>netstandard2.0</TargetFramework>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>Christoph Hornung</Authors>
		<PackageId>compujuckel.EmbeddedResourceAccessGenerator</PackageId>
		<Version>2.0.0</Version>
		<Copyright>Christoph Hornung</Copyright>
		<Description>Generates strongly typed access methods for embedded resources.</Description>
		<PackageProjectUrl>https://github.com/compujuckel/EmbeddedResourceGenerator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/compujuckel/EmbeddedResourceGenerator</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			v.2.0.0
			- Refactored to generate a class hierarchy instead of enums.
			- Resources are now accessed via nested classes mirroring the directory structure.
			- Dots in file names create additional nested classes (e.g., test.txt becomes Test.txt.GetStream()).
			- Uses ManifestResourceName metadata from MSBuild when available.
			v.1.1.5
			- Marked the nuget as a development dependency.
			v.1.1.4
			- No longer generating classes when no resources are present.
			v.1.1.3
			- Fixed issue with spaces in paths.
			v.1.1.2
			- Fixed issue with invalid character names in paths.
			v.1.1.1
			- Generating additional enums per folder.
			v.1.1.0
			- Switched to incremental source generation.
		</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<DevelopmentDependency>true</DevelopmentDependency>
		<PackageTags>embeddedresource;manifestresource;code-generator;source-generator;csharp</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Link="README.md" Pack="true" PackagePath=".">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="RootNamespace" />
		<CompilerVisibleProperty Include="EmbeddedResourcePrefix" />
		<CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SourceItemGroup" />
		<CompilerVisibleItemMetadata Include="EmbeddedResource" MetadataName="ManifestResourceName" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="lib\_._" Pack="true" PackagePath="lib/netstandard2.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="build\compujuckel.EmbeddedResourceAccessGenerator.props" Pack="true" PackagePath="build">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>